{
  "expo": {
    "name": "SmartDoor",
    "slug": "smartdoor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/components/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./app/components/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "현재 위치 기반 날씨와 우산 알림 서비스를 제공하기 위해 위치 정보 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/components/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./app/components/logo.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
